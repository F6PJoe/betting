# Credentials — never commit these
google_credentials.json
.env

# Machine-local Claude Code settings. Accumulates OAuth tokens at runtime —
# GitHub push protection blocked a push on 2026-08-07 when it was staged by
# mistake. Only the token-free 21-line version was ever pushed (initial commit);
# untracked from here on so a live token can never reach the remote.
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Runtime logs — regenerated every run, no reason to version them.
# run_log.txt was tracked on a PUBLIC repo; no credentials in it, but it created
# diff noise on every commit and leaked local Windows paths in tracebacks.
run_log.txt
clv_log.txt
